diff --git a/src/thread/n3ds/SDL_syscond.c b/src/thread/n3ds/SDL_syscond.c
index c5eae40..b392739 100644
--- a/src/thread/n3ds/SDL_syscond.c
+++ b/src/thread/n3ds/SDL_syscond.c
@@ -105,12 +105,28 @@ int SDL_CondWaitTimeout(SDL_cond *cond, SDL_mutex *mutex, Uint32 ms)
         return SDL_InvalidParamError("mutex");
     }
 
-    res = 0;
-    if (ms == SDL_MUTEX_MAXWAIT) {
-        CondVar_Wait(&cond->cond_variable, &mutex->lock.lock);
-    } else {
-        res = CondVar_WaitTimeout(&cond->cond_variable, &mutex->lock.lock,
-                                  (s64)ms * 1000000LL);
+    /* Crispy Doom (3DS port): the mutex is a RecursiveLock and the wait
+       only releases its inner LightLock. The thread that then locked the
+       mutex (to signal) saw it still owned by this one, added to its count
+       and never released the LightLock: this thread could not wake up.
+       While waiting, the mutex is left unowned, then the owner restored. */
+    {
+        const u32 thread_tag = mutex->lock.thread_tag;
+        const u32 counter = mutex->lock.counter;
+
+        mutex->lock.thread_tag = 0;
+        mutex->lock.counter = 0;
+
+        res = 0;
+        if (ms == SDL_MUTEX_MAXWAIT) {
+            CondVar_Wait(&cond->cond_variable, &mutex->lock.lock);
+        } else {
+            res = CondVar_WaitTimeout(&cond->cond_variable, &mutex->lock.lock,
+                                      (s64)ms * 1000000LL);
+        }
+
+        mutex->lock.thread_tag = thread_tag;
+        mutex->lock.counter = counter;
     }
 
     return R_SUCCEEDED(res) ? 0 : SDL_MUTEX_TIMEDOUT;
