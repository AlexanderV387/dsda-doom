; [3DS] pgl self-test: as pgl_t4, through the texture matrix.
.fvec mvp[4]
.fvec unused[8]
.fvec texmtx[4]
.constf consts(1.0, 0.0, 0.00392156862745098, 0.0)
.out outpos position
.out outtc0 texcoord0
.out outtc0w texcoord0w
.out outclr color
.alias inpos v0
.alias intc v1
.alias inclr v2
.entry test5
.proc test5
	mov r0.xyz, inpos
	mov r0.w, consts.xxxx
	dp4 outpos.x, mvp[0], r0
	dp4 outpos.y, mvp[1], r0
	dp4 outpos.z, mvp[2], r0
	dp4 outpos.w, mvp[3], r0
	mul outclr, consts.zzzz, inclr
	mov r2.xy, intc
	mov r2.z, consts.yyyy
	mov r2.w, consts.xxxx
	dp4 outtc0.x, texmtx[0], r2
	dp4 outtc0.y, texmtx[1], r2
	dp4 outtc0w.x, texmtx[3], r2
	end
.end
