; [3DS] pgl's vertex shader: OpenGL's fixed function vertex stage, as far as
; DSDA-Doom uses it. The projection, the modelview and the screen rotation
; come in one matrix (mvp); texture coordinates go through the texture
; matrix, either as given or made from the eye position (glTexGen,
; GL_EYE_LINEAR). No branches: both are computed and texgen_on (1 or 0)
; picks one, with a multiplication.

.fvec mvp[4]       ; rotation * projection * modelview
.fvec modelview[4] ; for glTexGen
.fvec texgen[4]    ; the S, T, R and Q eye planes
.fvec texmtx[4]    ; the texture matrix
.fvec texgen_on    ; x: 1 to make the coordinates, 0 to take them

.constf consts(1.0, 0.0, 0.00392156862745098, 0.0)
.alias ONE consts.xxxx
.alias ZERO consts.yyyy
.alias INV255 consts.zzzz

.out outpos position
.out outtc0 texcoord0
.out outtc0w texcoord0w
.out outclr color

.alias inpos v0 ; x, y, z
.alias intc v1  ; s, t
.alias inclr v2 ; r, g, b, a: 0 to 255

.proc main
	mov r0.xyz, inpos
	mov r0.w, ONE

	dp4 outpos.x, mvp[0], r0
	dp4 outpos.y, mvp[1], r0
	dp4 outpos.z, mvp[2], r0
	dp4 outpos.w, mvp[3], r0

	mul outclr, INV255, inclr

	; The coordinates as given: s, t, 0, 1.
	mov r2.xy, intc
	mov r2.z, ZERO
	mov r2.w, ONE

	; Made from the eye position.
	dp4 r1.x, modelview[0], r0
	dp4 r1.y, modelview[1], r0
	dp4 r1.z, modelview[2], r0
	dp4 r1.w, modelview[3], r0
	dp4 r3.x, texgen[0], r1
	dp4 r3.y, texgen[1], r1
	dp4 r3.z, texgen[2], r1
	dp4 r3.w, texgen[3], r1

	; r2 + texgen_on * (r3 - r2)
	add r3, r3, -r2
	mul r3, texgen_on.xxxx, r3
	add r2, r2, r3

	; Every component of every output is written: the PICA200 hangs on
	; what a shader leaves in them otherwise (garbage, NaN).
	dp4 r4.x, texmtx[0], r2
	dp4 r4.y, texmtx[1], r2
	mov r4.z, ZERO
	dp4 r4.w, texmtx[3], r2
	mov outtc0, r4
	mov outtc0w, r4.wwww

	end
.end
