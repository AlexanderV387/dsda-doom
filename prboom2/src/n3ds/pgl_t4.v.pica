; [3DS] pgl self-test: position, color, texture coordinates and their w.
.fvec mvp[4]
.constf consts(1.0, 0.0, 0.00392156862745098, 0.0)
.out outpos position
.out outtc0 texcoord0
.out outtc0w texcoord0w
.out outclr color
.alias inpos v0
.alias intc v1
.alias inclr v2
.entry test4
.proc test4
	mov r0.xyz, inpos
	mov r0.w, consts.xxxx
	dp4 outpos.x, mvp[0], r0
	dp4 outpos.y, mvp[1], r0
	dp4 outpos.z, mvp[2], r0
	dp4 outpos.w, mvp[3], r0
	mul outclr, consts.zzzz, inclr
	mov outtc0, intc
	mov outtc0w, consts.xxxx
	end
.end
