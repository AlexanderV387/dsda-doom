; [3DS] pgl self-test: as pgl_t5, with a branch on a bool uniform.
.fvec mvp[4]
.fvec unused[8]
.fvec texmtx[4]
.bool use_texgen
.constf consts(1.0, 0.0, 0.00392156862745098, 0.0)
.out outpos position
.out outtc0 texcoord0
.out outtc0w texcoord0w
.out outclr color
.alias inpos v0
.alias intc v1
.alias inclr v2
.entry test6
.proc test6
	mov r0.xyz, inpos
	mov r0.w, consts.xxxx
	dp4 outpos.x, mvp[0], r0
	dp4 outpos.y, mvp[1], r0
	dp4 outpos.z, mvp[2], r0
	dp4 outpos.w, mvp[3], r0
	mul outclr, consts.zzzz, inclr
	ifu use_texgen
		mov r2, consts.yyyy
	.else
		mov r2.xy, intc
		mov r2.z, consts.yyyy
		mov r2.w, consts.xxxx
	.end
	dp4 r4.x, texmtx[0], r2
	dp4 r4.y, texmtx[1], r2
	mov r4.z, consts.yyyy
	dp4 r4.w, texmtx[3], r2
	mov outtc0, r4
	mov outtc0w, r4.wwww
	end
.end
